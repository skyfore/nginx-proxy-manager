{
	"operationId": "createApiToken",
	"summary": "Create a personal API token (JWT session and password/2FA required)",
	"tags": [
		"api-tokens"
	],
	"security": [
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"201": {
			"description": "Successful operation",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../components/api-token-created.json"
					}
				}
			}
		},
		"401": {
			"description": "Authentication required"
		},
		"403": {
			"description": "Session, owner permissions or step-up verification required"
		}
	},
	"requestBody": {
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"name",
						"scopes",
						"password"
					],
					"properties": {
						"name": {
							"type": "string",
							"minLength": 1,
							"maxLength": 100
						},
						"scopes": {
							"type": "array",
							"minItems": 1,
							"maxItems": 12,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"enum": [
									"proxy_hosts:read",
									"proxy_hosts:write",
									"redirection_hosts:read",
									"redirection_hosts:write",
									"dead_hosts:read",
									"dead_hosts:write",
									"streams:read",
									"streams:write",
									"access_lists:read",
									"access_lists:write",
									"certificates:read",
									"certificates:write"
								]
							}
						},
						"expires_in_days": {
							"type": "integer",
							"minimum": 1,
							"maximum": 365,
							"default": 30
						},
						"password": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						},
						"code": {
							"type": "string",
							"minLength": 6,
							"maxLength": 8
						}
					}
				}
			}
		}
	}
}
