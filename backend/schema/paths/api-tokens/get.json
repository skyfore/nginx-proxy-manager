{
	"operationId": "getApiTokens",
	"summary": "List personal API token metadata",
	"tags": [
		"api-tokens"
	],
	"security": [
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "Successful operation",
			"content": {
				"application/json": {
					"schema": {
						"type": "array",
						"items": {
							"$ref": "../../components/api-token-object.json"
						}
					}
				}
			}
		},
		"401": {
			"description": "Authentication required"
		},
		"403": {
			"description": "Session, owner permissions or step-up verification required"
		}
	}
}
